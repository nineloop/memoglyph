# Copie ce fichier en .env et renseigne les valeurs.
# .env est ignoré par git (voir .gitignore).
#
# Préfixe des variables : MEMOGLYPH_. Dans CE fichier, une ligne laissée vide est
# ignorée. Le piège est dans l'environnement du shell : `export MEMOGLYPH_X=` (vide)
# compte comme défini ; sans valeur ici, le réglage vaut alors la chaîne vide et non
# son défaut. Retirer la variable (`unset`) plutôt que la vider.

# Token Hugging Face — requis UNIQUEMENT pour la diarisation (pyannote, modèles gated).
# 1. Crée un token : https://huggingface.co/settings/tokens
# 2. Accepte les conditions du modèle : https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# ---------- Mode cloud (Mistral) ----------
# Transcription par Voxtral et/ou comptes-rendus par Mistral Chat. Sans cette
# clé, l'interface propose toujours le mode cloud mais l'annonce indisponible.
# Elle doit figurer ici : sans elle, personne ne peut deviner son nom.
MISTRAL_API_KEY=

# Modèles cloud Mistral. Ces variables sont lues SANS préfixe (core/config.py) ;
# vides = valeurs par défaut du code (voxtral-mini-2602 et ministral-14b-2512).
MISTRAL_STT_MODEL=
MISTRAL_CHAT_MODEL=

# ---------- Mode cloud (OpenAI) ----------
# Comptes-rendus / profilage / RAG via l'API Responses (pas de transcription).
# Sans cette clé, l'interface propose OpenAI mais l'annonce indisponible.
OPENAI_API_KEY=
# Modèle OpenAI. Vide = gpt-5.6-luna. Préfixe MEMOGLYPH_.
MEMOGLYPH_OPENAI_CHAT_MODEL=

# ---------- Serveur compatible OpenAI (fournisseur « compatible ») ----------
# Ollama, LM Studio, vLLM… : Memoglyph s'y connecte, sans le démarrer ni l'arrêter.
# Proposé seulement si l'URL ET le modèle sont renseignés. Sur 127.0.0.1 ou
# localhost, il compte comme local ; ailleurs, comme un cloud (« cloud privé ») :
# un document ultra-confidentiel n'y part qu'avec l'autorisation du compte.
# Exemple Ollama : COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
# Facultative : seulement si le serveur exige une clé. Jamais affichée ni journalisée.
COMPATIBLE_API_KEY=

# ---------- Fournisseurs en ligne nommés : OpenRouter et Groq ----------
# Deux services EN LIGNE, proposés sous leur nom, seulement si la clé ET le modèle sont renseignés. Ils suivent la règle
# d'envoi des fournisseurs en ligne : un document ultra-confidentiel n'y part qu'avec l'autorisation du compte. Les clés sont
# saisies par vous, jamais affichées ni journalisées ; elles ne se passent pas par requête. Le modèle se choisit ici : aucune
# liste n'est figée dans le code (les modèles changent souvent). Préfixe MEMOGLYPH_ pour le modèle.
OPENROUTER_API_KEY=
MEMOGLYPH_OPENROUTER_MODEL=
GROQ_API_KEY=
MEMOGLYPH_GROQ_MODEL=

# ---------- Faits de la réunion (ECL), expérimentaux ----------
# Coupés par défaut. 1 = l'onglet « Faits », ses routes, l'outil MCP `lire_faits` et
# `memoglyph ecl-extraire`. En local, ils utilisent ibm-granite/granite-4.2-8b-q4-mlx
# (4,9 Go), à télécharger seulement si on les active. Coupés, les faits déjà extraits
# restent sur disque et reviennent si on les réactive.
MEMOGLYPH_FAITS=

# ---------- Moteur LLM local MLX (fournisseur « mlx ») ----------
# Serveur `mlx_lm.server` supervisé par core/llm_mlx.py, sur Apple Silicon.
# Vide = mlx-community/Qwen3-4B-Instruct-2507-4bit (2,1 Go, à télécharger).
#
# Le modèle doit être SANS RAISONNEMENT. Un modèle qui réfléchit met sa sortie
# dans un champ `reasoning` hors norme OpenAI et laisse `content` vide ; le
# moteur le détecte et le refuse en nommant cette variable, plutôt que de
# conclure à tort à une panne de serveur.
MEMOGLYPH_MLX_LLM_MODEL=

# Plafond de génération du serveur. Vide = 16384.
# NE PAS laisser mlx_lm à son défaut : il est de 512 jetons, et tout
# compte-rendu plus long est coupé net. `chat()` n'a aucun moyen de relever
# cette borne — le contrat LLMEngine n'expose pas `max_tokens`.
MEMOGLYPH_MLX_MAX_TOKENS=

# Port ÉPINGLÉ, vide = 8772. NE PAS mettre 8080 (le défaut de mlx_lm.server) :
# il est trop souvent déjà pris, et une collision donnerait un moteur
# silencieusement FAUX — le serveur d'en face répond. 8770 et 8771 sont
# l'interface et l'API.
MEMOGLYPH_MLX_PORT=
